{
  "manifest_version": 3,
  "name": "Rhitmo Recorder",
  "version": "2.0.0",
  "description": "Grava reuniões do Google Meet automaticamente e envia para o Rhitmo.",
  "permissions": ["tabCapture", "activeTab", "storage", "tabs", "offscreen"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}