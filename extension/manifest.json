{
  "manifest_version": 3,
  "name": "Rhitmo Recorder",
  "version": "1.0.0",
  "description": "Grave reuniões do Google Meet com 1 click e envie automaticamente para o Rhitmo.",
  "permissions": ["tabCapture", "activeTab", "storage", "tabs"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
